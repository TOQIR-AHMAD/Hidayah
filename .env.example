# Optional environment overrides for the Quran Video Generator.
# Copy this file to ".env" and edit. Every value is optional.

# Absolute path to ffmpeg / ffprobe if they are not on your PATH.
# Windows example:
# QVG_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
# QVG_FFPROBE=C:\ffmpeg\bin\ffprobe.exe
QVG_FFMPEG=
QVG_FFPROBE=

# Alternative config file (defaults to ./config.yaml)
QVG_CONFIG=

# Log level: DEBUG, INFO, WARNING, ERROR
QVG_LOG_LEVEL=INFO

# Number of FFmpeg encoding threads (0 = auto)
QVG_THREADS=0
