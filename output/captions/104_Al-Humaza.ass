Dialogue: 0,0:00:00.16,0:00:03.91,Arabic,,0,0,0,,وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ
Dialogue: 0,0:00:04.11,0:00:08.48,Arabic,,0,0,0,,ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ
Dialogue: 0,0:00:08.68,0:00:14.08,Arabic,,0,0,0,,يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ
Dialogue: 0,0:00:14.28,0:00:19.74,Arabic,,0,0,0,,كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ
Dialogue: 0,0:00:19.94,0:00:24.03,Arabic,,0,0,0,,وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ
Dialogue: 0,0:00:24.23,0:00:27.10,Arabic,,0,0,0,,نَارُ ٱللَّهِ ٱلْمُوقَدَةُ
