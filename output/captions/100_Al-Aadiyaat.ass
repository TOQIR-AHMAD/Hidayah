Dialogue: 0,0:00:00.16,0:00:02.86,Arabic,,0,0,0,,وَٱلْعَٰدِيَٰتِ ضَبْحًۭا
Dialogue: 0,0:00:03.06,0:00:05.74,Arabic,,0,0,0,,فَٱلْمُورِيَٰتِ قَدْحًۭا
Dialogue: 0,0:00:05.94,0:00:08.49,Arabic,,0,0,0,,فَٱلْمُغِيرَٰتِ صُبْحًۭا
Dialogue: 0,0:00:08.69,0:00:11.22,Arabic,,0,0,0,,فَأَثَرْنَ بِهِۦ نَقْعًۭا
Dialogue: 0,0:00:11.42,0:00:14.14,Arabic,,0,0,0,,فَوَسَطْنَ بِهِۦ جَمْعًا
Dialogue: 0,0:00:14.34,0:00:20.56,Arabic,,0,0,0,,إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ
Dialogue: 0,0:00:20.76,0:00:26.25,Arabic,,0,0,0,,وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ
