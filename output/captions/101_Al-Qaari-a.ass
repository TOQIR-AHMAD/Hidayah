Dialogue: 0,0:00:00.16,0:00:02.09,Arabic,,0,0,0,,ٱلْقَارِعَةُ
Dialogue: 0,0:00:02.29,0:00:04.19,Arabic,,0,0,0,,مَا ٱلْقَارِعَةُ
Dialogue: 0,0:00:04.39,0:00:08.94,Arabic,,0,0,0,,وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ
Dialogue: 0,0:00:09.14,0:00:15.43,Arabic,,0,0,0,,يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ
Dialogue: 0,0:00:15.63,0:00:21.78,Arabic,,0,0,0,,وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ
Dialogue: 0,0:00:21.98,0:00:26.65,Arabic,,0,0,0,,فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ
Dialogue: 0,0:00:26.85,0:00:30.01,Arabic,,0,0,0,,فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ
Dialogue: 0,0:00:30.21,0:00:34.34,Arabic,,0,0,0,,وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ
Dialogue: 0,0:00:34.54,0:00:37.38,Arabic,,0,0,0,,فَأُمُّهُۥ هَاوِيَةٌۭ
Dialogue: 0,0:00:37.58,0:00:41.26,Arabic,,0,0,0,,وَمَآ أَدْرَىٰكَ مَا هِيَهْ
Dialogue: 0,0:00:41.46,0:00:45.56,Arabic,,0,0,0,,نَارٌ حَامِيَةٌۢ
